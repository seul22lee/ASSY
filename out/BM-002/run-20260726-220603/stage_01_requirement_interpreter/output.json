  "source_text": "Design a compact desktop lifting box. The user should rotate an external hand crank to raise and lower an internal platform. The platform should lift approximately 80-100 mm and support a payload of approximately 1 kg. The mechanism should be enclosed inside the housing. The product should be safe to use, mechanically plausible, easy to assemble, and practical to manufacture. Avoid obvious jamming or unstable operation.",
  "product_intent": "Design a compact desktop lifting box",
  "clauses": [
    {
      "id": "C-001",
      "text": "Design a compact desktop lifting box.",
      "source": "request",
      "disposition": "constraint"
    },
    {
      "id": "C-002",
      "text": "The user should rotate an external hand crank to raise and lower an internal platform.",
      "source": "request",
      "disposition": "function"
    },
    {
      "id": "C-003",
      "text": "The platform should lift approximately 80-100 mm and support a payload of approximately 1 kg.",
      "source": "request",
      "disposition": "function"
    },
    {
      "id": "C-004",
      "text": "The mechanism should be enclosed inside the housing.",
      "source": "request",
      "disposition": "function"
    },
    {
      "id": "C-005",
      "text": "The product should be safe to use, mechanically plausible, easy to assemble, and practical to manufacture.",
      "source": "request",
      "disposition": "constraint"
    },
    {
      "id": "C-006",
      "text": "Avoid obvious jamming or unstable operation.",
      "source": "request",
      "disposition": "constraint"
    },
    {
      "id": "C-007",
      "text": "Desktop-sized product.",
      "source": "clarification",
      "disposition": "constraint"
    },
    {
      "id": "C-008",
      "text": "Manual operation only.",
      "source": "clarification",
      "disposition": "freedom"
    },
    {
      "id": "C-009",
      "text": "Continuous or intermittent lifting is acceptable.",
      "source": "clarification",
      "disposition": "freedom"
    },
    {
      "id": "C-010",
      "text": "Self-locking is optional if justified.",
      "source": "clarification",
      "disposition": "freedom"
    },
    {
      "id": "C-011",
      "text": "Multiple shafts, bearings, guides, and supports are allowed.",
      "source": "clarification",
      "disposition": "freedom"
    }
  ],
