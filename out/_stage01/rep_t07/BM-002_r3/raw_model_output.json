{
  "product_intent": "A desktop-sized manual lifting device that raises and lowers an internal platform through external hand crank rotation",
  "clauses": [
    {
      "id": "C-001",
      "text": "Design a compact desktop lifting box",
      "source": "request",
      "disposition": "function"
    },
    {
      "id": "C-002",
      "text": "The user should rotate an external hand crank to raise and lower an internal platform",
      "source": "request",
      "disposition": "function"
    },
    {
      "id": "C-003",
      "text": "The platform should lift approximately 80-100 mm",
      "source": "request",
      "disposition": "performance"
    },
    {
      "id": "C-004",
      "text": "The platform should support a payload of approximately 1 kg",
      "source": "request",
      "disposition": "performance"
    },
    {
      "id": "C-005",
      "text": "The mechanism should be enclosed inside the housing",
      "source": "request",
      "disposition": "constraint"
    },
    {
      "id": "C-006",
      "text": "The product should be safe to use, mechanically plausible, easy to assemble, and practical to manufacture",
      "source": "request",
      "disposition": "constraint"
    },
    {
      "id": "C-007",
      "text": "Avoid obvious jamming or unstable operation",
      "source": "request",
      "disposition": "constraint"
    },
    {
      "id": "C-008",
      "text": "Desktop-sized product",
      "source": "clarification",
