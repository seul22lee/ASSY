    "opening_stop.length",
    "opening_stop.width"
  ],
  "constraints": [
    {
      "subject": "covers.closure_member",
      "expression": "closure_member.length >= housing.length - 2*housing.wall",
      "why": "a closure occludes an aperture only if it is at least as large as the opening it covers"
    },
    {
      "subject": "closure_member.self_locking_limit",
      "expression": "retention_angle < atan(1/mu)",
      "why": "closure_member retention angle must stay below the self-locking angle"
    },
    {
      "subject": "detent_feature.self_locking_limit",
      "expression": "retention_angle < atan(1/mu)",
      "why": "detent_feature retention angle must stay below the self-locking angle"
    },
    {
      "subject": "motion.opening_interface.deflection_allowable",
      "expression": null,
      "why": "motion.opening_interface deflection allowable"
    }
  ],
  "objectives": [
    {
      "subject": "objective.envelope",
      "expression": "minimise (closure_member.thickness/2) + (housing.height/2)"
    },
    {
      "subject": "retention_vs_release",
      "expression": "maximize(retention_force) subject to release_force <= 15 N"
    }
  ]
}