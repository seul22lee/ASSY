<mujoco model="assy_latch">
  <compiler angle="degree"/>
  <option timestep="0.0002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic"/>
  <visual><global offwidth="960" offheight="720"/></visual>
  <default>
    <geom rgba="0.72 0.74 0.78 1" friction="0.35 0.005 0.0001" solref="0.002 1"/>
