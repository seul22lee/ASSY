    <body name="lid" pos="0 -0.04500 0.12580">
      <joint name="lid_hinge" type="hinge" axis="1 0 0" range="-1 105.0" damping="0.0015"/>
      <geom name="lid_plate" type="box" size="0.05500 0.04500 0.00300"
            pos="0 0.04500 0" mass="0.05" contype="2" conaffinity="2"/>
      <geom name="lid_rib" type="box"
