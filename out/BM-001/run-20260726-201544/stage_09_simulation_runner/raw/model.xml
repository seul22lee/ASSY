            pos="0 0.08490 -0.02870" mass="0.003"
            rgba="0.55 0.78 0.55 1" contype="4" conaffinity="4"/>
      <geom name="lid_lip" type="box"
            size="0.00300 0.00040 0.00090"
            pos="0 0.08590 -0.05810" mass="0.001"
            rgba="0.35 0.68 0.35 1" contype="4" conaffinity="4"/>
    </body>
  </worldbody>

  <actuator>
    <position name="lid_drive" joint="lid_hinge" kp="0.5" ctrlrange="-1 105.0"
              forcerange="-2.5 2.5"/>
    <position name="beam_release" joint="beam_flex" kp="3.024" ctrlrange="-35 0"
              forcerange="-1.583 1.583"/>
  </actuator>
</mujoco>
