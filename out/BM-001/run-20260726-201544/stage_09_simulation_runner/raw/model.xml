            contype="1" conaffinity="1"/>
      <geom name="wall_left" type="box" size="0.00240 0.04500 0.06000"
            pos="-0.05500 0 0.06240" contype="1" conaffinity="1"/>
      <geom name="wall_right" type="box" size="0.00240 0.04500 0.06000"
            pos="0.05500 0 0.06240" contype="1" conaffinity="1"/>
      <geom name="wall_rear" type="box" size="0.05500 0.00240 0.06000"
            pos="0 -0.04500 0.06240" contype="1" conaffinity="1"/>
      <geom name="wall_front" type="box" size="0.05500 0.00240 0.06000"
            pos="0 0.04500 0.06240" contype="1" conaffinity="1"/>

      <body name="snap_beam" pos="0 0.04200 0.05880">
        <joint name="beam_flex" type="hinge" axis="1 0 0" range="-35 2"
               stiffness="0.75600" damping="0.003935" armature="2.000e-06"
               springref="0"/>
        <geom name="beam" type="box"
              size="0.00300 0.00060 0.00600"
              pos="0 0 0.00600" mass="0.0004" rgba="0.30 0.62 0.85 1"
              contype="4" conaffinity="4"/>
        <geom name="hook" type="box"
              size="0.00300 0.00040 0.0008"
              pos="0 -0.00100 0.01080" mass="0.0001"
